+extern "C" int coli_metal_rtop8_cache(
+    const float *sig, const float *bias, const uint8_t *resident,
+    int S, int E, int K, int Ksel, int route_j, int route_m,
+    float topp, int normk, float rscale,
+    int *idx, float *w, int *keff, int *true_idx, float *true_w) {
