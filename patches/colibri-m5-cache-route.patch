+// Experimental cache-aware max-rank selection. One simdgroup builds the exact
+// top-M ranking in parallel, then lane 0 keeps true top-J and fills from resident
+// experts before falling back to rank order. true_idx/true_w preserve quality
+// telemetry against the unmodified top-K router.
+kernel void r_top_cache_par(
+    device const float* sig [[buffer(0)]], device const float* bias [[buffer(1)]],
+    device int* idx [[buffer(2)]], device float* w [[buffer(3)]],
+    device int* keff [[buffer(4)]], constant int& E [[buffer(5)]],
+    constant int& K [[buffer(6)]], constant int& Ksel [[buffer(7)]],
+    constant float& topp [[buffer(8)]], constant int& normk [[buffer(9)]],
+    constant float& rscale [[buffer(10)]],
+    constant uchar* resident [[buffer(11)]],
+    device int* true_idx [[buffer(12)]], device float* true_w [[buffer(13)]],
+    constant int& route_j [[buffer(14)]], constant int& route_m [[buffer(15)]],
+    uint s [[threadgroup_position_in_grid]],
+    uint slane [[thread_index_in_simdgroup]]) {
+  if(E>256 || route_m>K*8 || route_m<Ksel) return;
+  device const float* sg=sig+(long)s*E;
+  device int* id_=idx+(long)s*K; device float* ww=w+(long)s*K;
+  device int* ti=true_idx+(long)s*K; device float* tw=true_w+(long)s*K;
+  threadgroup int rank_id[64]; threadgroup float rank_w[64];
+  int per=(E+31)/32, base=(int)slane*per;
+  float ch[8]; uint taken=0u;
+  for(int j=0;j<per;j++){ int e=base+j; ch[j]=(e<E)?sg[e]+bias[e]:-1e30f; }
+  for(int kk=0;kk<route_m;kk++){
+    float bv=-1e30f; int bi=0x7FFFFFFF;
+    for(int j=0;j<per;j++) if(!(taken&(1u<<j)) && ch[j]>bv){ bv=ch[j]; bi=base+j; }
+    for(uint off=16;off>0;off>>=1){
+      float ov=simd_shuffle_down(bv,off); int oi=simd_shuffle_down(bi,off);
+      if(ov>bv || (ov==bv && oi<bi)){ bv=ov; bi=oi; }
+    }
+    bi=simd_broadcast(bi,0);
+    if(bi>=base && bi<base+per) taken|=1u<<(bi-base);
+    if(slane==0){ rank_id[kk]=bi; rank_w[kk]=sg[bi]; }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if(slane!=0) return;
+  for(int kk=0;kk<Ksel;kk++){ ti[kk]=rank_id[kk]; tw[kk]=rank_w[kk]; }
+  int J=clamp(route_j,0,Ksel), chosen=0;
+  for(int r=0;r<J;r++){ id_[chosen]=rank_id[r]; ww[chosen]=rank_w[r]; chosen++; }
+  for(int r=J;r<route_m && chosen<Ksel;r++){
+    int e=rank_id[r], duplicate=0;
+    for(int j=0;j<chosen;j++) if(id_[j]==e){ duplicate=1; break; }
+    if(!duplicate && resident[e]){ id_[chosen]=e; ww[chosen]=rank_w[r]; chosen++; }
+  }
+  for(int r=0;r<route_m && chosen<Ksel;r++){
+    int e=rank_id[r], duplicate=0;
+    for(int j=0;j<chosen;j++) if(id_[j]==e){ duplicate=1; break; }
+    if(!duplicate){ id_[chosen]=e; ww[chosen]=rank_w[r]; chosen++; }
+  }
+  int Ke=Ksel;
+  if(topp>0.0f && topp<1.0f){
+    for(int a=1;a<Ksel;a++){ int ii=id_[a]; float wv=ww[a]; int b=a-1;
+      while(b>=0 && ww[b]<wv){ ww[b+1]=ww[b]; id_[b+1]=id_[b]; b--; }
+      ww[b+1]=wv; id_[b+1]=ii; }
+    float tot=1e-20f; for(int kk=0;kk<Ksel;kk++) tot+=ww[kk];
+    float cum=0; for(int kk=0;kk<Ksel;kk++){ cum+=ww[kk]; if(cum>=topp*tot){ Ke=kk+1; break; } }
+  }
+  keff[s]=Ke;
+  if(normk){ float sm=0; for(int kk=0;kk<Ke;kk++) sm+=ww[kk]; sm+=1e-20f;
+    for(int kk=0;kk<Ke;kk++) ww[kk]/=sm; }
+  for(int kk=0;kk<Ke;kk++) ww[kk]*=rscale;
+}
