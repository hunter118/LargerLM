+static int run_cache_rtop8(int route_m, const char *name) {
+  const int S=4,E=256,K=8,Ksel=8,J=2;
+  std::vector<float> sig((size_t)S*E),bias(E);
+  std::vector<uint8_t> resident(E);
+  for(int e=0;e<E;e++){ bias[e]=(float)((e*17)%37)/1000.f; resident[e]=(e%5)==0; }
+  for(int s=0;s<S;s++) for(int e=0;e<E;e++)
+    sig[(size_t)s*E+e]=(float)(((e*73+s*41)%997)+1)/1000.f;
+  std::vector<int> gi((size_t)S*K),gk(S),gti((size_t)S*K);
+  std::vector<float> gw((size_t)S*K),gtw((size_t)S*K);
+  if(!coli_metal_rtop8_cache(sig.data(),bias.data(),resident.data(),S,E,K,Ksel,J,route_m,
+                             0.f,1,1.f,gi.data(),gw.data(),gk.data(),gti.data(),gtw.data())){
+    printf("  %-34s FAIL (cache rtop8 runner returned 0)\n",name); return 1; }
+  int ok=1,changed=0;
+  for(int s=0;s<S;s++){
+    std::vector<int> rank(route_m),used(E,0),ref;
+    for(int r=0;r<route_m;r++){
+      float bv=-1e30f; int bi=0x7fffffff;
+      for(int e=0;e<E;e++) if(!used[e]){
+        float v=sig[(size_t)s*E+e]+bias[e];
+        if(v>bv||(v==bv&&e<bi)){ bv=v; bi=e; }
+      }
+      rank[r]=bi; used[bi]=1;
+    }
+    for(int r=0;r<J;r++) ref.push_back(rank[r]);
+    for(int r=J;r<route_m&&(int)ref.size()<Ksel;r++) if(resident[rank[r]]) ref.push_back(rank[r]);
+    for(int r=0;r<route_m&&(int)ref.size()<Ksel;r++){
+      int dup=0; for(int e:ref) if(e==rank[r]) dup=1;
+      if(!dup) ref.push_back(rank[r]);
+    }
+    float sum=0; for(int k=0;k<Ksel;k++) sum+=sig[(size_t)s*E+ref[k]];
+    for(int k=0;k<Ksel;k++){
+      if(gi[(size_t)s*K+k]!=ref[k] || gti[(size_t)s*K+k]!=rank[k] ||
+         fabsf(gw[(size_t)s*K+k]-sig[(size_t)s*E+ref[k]]/sum)>2e-7f ||
+         gtw[(size_t)s*K+k]!=sig[(size_t)s*E+rank[k]]) ok=0;
+      if(ref[k]!=rank[k]) changed=1;
+    }
+    if(gk[s]!=Ksel) ok=0;
+  }
+  ok=ok&&changed;
+  printf("  %-34s %s\n",name,ok?"ok (GPU==CPU reference)":"*** MISMATCH");
+  return ok?0:1;
+}
